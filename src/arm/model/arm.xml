<mujoco model="arm">

  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="0.1" frictionloss="0.01"/>
    <geom type="mesh" contype="1" conaffinity="1"/>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="link1" file="link1.STL"/>
    <mesh name="link2" file="link2.STL"/>
    <mesh name="link3" file="link3.STL"/>
    <mesh name="link4" file="link4.STL"/>
  </asset>

  <worldbody>

    <body name="base_link" pos="0 0 0">

      <geom mesh="base_link"/>

      <body name="link1" pos="-0.000032465 0.000010134 0.066">

        <joint name="joint1" type="hinge" axis="0 0 -1"/>

        <geom mesh="link1"/>

        <body name="link2" pos="0.3275 -0.0335 0.0485" euler="1.5708 0 0">

          <joint name="joint2" type="hinge" axis="0 0 1"/>

          <geom mesh="link2"/>

          <body name="link3" pos="0.3695 0 -0.044">

            <joint name="joint3" type="hinge" axis="0 0 1"/>

            <geom mesh="link3"/>

            <body name="link4" pos="0.2 0.004 -0.026">

              <joint name="joint4" type="hinge" axis="0 0 1"/>

              <geom mesh="link4"/>

            </body>

          </body>

        </body>

      </body>

    </body>

  </worldbody>


  <actuator>

    <motor name="motor1" joint="joint1" ctrlrange="-3.14 3.14" gear="100"/>
    <motor name="motor2" joint="joint2" ctrlrange="-3.14 3.14" gear="100"/>
    <motor name="motor3" joint="joint3" ctrlrange="-3.14 3.14" gear="100"/>
    <motor name="motor4" joint="joint4" ctrlrange="-3.14 3.14" gear="100"/>

  </actuator>

</mujoco>

